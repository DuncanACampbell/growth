# Firebase web app config (from Firebase Console → Project settings).
# These are public client values, not LLM API keys. Do not put provider keys here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional. Defaults to us-central1 (must match the Cloud Function region).
# EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Optional. Only in development: point callable functions at the local emulator.
# iOS simulator / web: 127.0.0.1:5001
# Android emulator: 10.0.2.2:5001
# Physical device: your computer's LAN IP, e.g. 192.168.1.20:5001
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1:5001
